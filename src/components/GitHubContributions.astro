---
import type { Locale } from "$utils/i18n";

interface Props {
  username: string;
  locale: Locale;
}

type ContributionLevel =
  | "NONE"
  | "FIRST_QUARTILE"
  | "SECOND_QUARTILE"
  | "THIRD_QUARTILE"
  | "FOURTH_QUARTILE";

interface ContributionDay {
  contributionCount: number;
  contributionLevel: ContributionLevel;
  date: string;
  weekday: number;
}

interface ContributionWeek {
  contributionDays: ContributionDay[];
}

interface ContributionCalendar {
  totalContributions: number;
  weeks: ContributionWeek[];
}

interface GitHubResponse {
  data?: {
    user: {
      contributionsCollection: {
        contributionCalendar: ContributionCalendar;
      };
    } | null;
  };
  errors?: Array<{ message: string }>;
}

const query = `
  query ContributionCalendar($login: String!) {
    user(login: $login) {
      contributionsCollection {
        contributionCalendar {
          totalContributions
          weeks {
            contributionDays {
              contributionCount
              contributionLevel
              date
              weekday
            }
          }
        }
      }
    }
  }
`;

const levelNames: Record<ContributionLevel, string> = {
  NONE: "none",
  FIRST_QUARTILE: "first",
  SECOND_QUARTILE: "second",
  THIRD_QUARTILE: "third",
  FOURTH_QUARTILE: "fourth",
};

const { username } = Astro.props as Props;
const token =
  process.env.CONTRIBUTIONS_TOKEN?.trim() || process.env.GITHUB_TOKEN?.trim();

async function fetchCalendar(): Promise<ContributionCalendar | null> {
  if (!token) {
    return null;
  }

  const response = await fetch("https://api.github.com/graphql", {
    method: "POST",
    headers: {
      Accept: "application/vnd.github+json",
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json",
      "User-Agent": "myrt.co",
    },
    body: JSON.stringify({ query, variables: { login: username } }),
  });

  if (!response.ok) {
    throw new Error(`GitHub GraphQL API returned ${response.status}`);
  }

  const payload = (await response.json()) as GitHubResponse;

  if (payload.errors?.length) {
    throw new Error(
      `GitHub GraphQL API: ${payload.errors.map(({ message }) => message).join("; ")}`,
    );
  }

  return (
    payload.data?.user?.contributionsCollection.contributionCalendar ?? null
  );
}

const calendar = await fetchCalendar();
---

{calendar && (
  <div class="contributions honey" data-hold="400">
    <a
      class="contributions-link"
      href={`https://github.com/${username}`}
      aria-hidden="true"
    >
      <div class="calendar-scroll" dir="rtl">
        <div
          class="calendar"
          dir="ltr"
          style={`--week-count: ${calendar.weeks.length}`}
        >
          <div class="weeks" aria-hidden="true">
            {calendar.weeks.map((week) => (
              <div class="week">
                {week.contributionDays.map((day) => (
                  <span
                    class="day"
                    data-level={levelNames[day.contributionLevel]}
                    style={`grid-row: ${day.weekday + 1}`}
                  />
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </a>
  </div>
)}

<style>
  .contributions {
    --cell-size: 10px;
    --cell-gap: 3px;
    --level-base: 0 189 108;
    --level-none: rgb(var(--level-base) / 2%);
    --level-first: rgb(var(--level-base) / 18%);
    --level-second: rgb(var(--level-base) / 34%);
    --level-third: rgb(var(--level-base) / 57%);
    --level-fourth: rgb(var(--level-base) / 86%);

    max-width: var(--size-layout-content-narrow);
    margin-top: 27px;
  }

  .contributions-link {
    width: fit-content;
    max-width: 100%;
    display: block;
    text-decoration: none;
    /*transition: opacity 240ms ease-out;*/
  }

  .contributions-link:hover,
  .contributions-link:focus-visible {
    transition-duration: 0s;
    /*opacity: 1;*/
  }

  .calendar-scroll {
    overflow-x: hidden;
    padding: 2px 0;
    scrollbar-width: none;
  }

  .calendar-scroll::-webkit-scrollbar {
    display: none;
  }

  .calendar {
    width: max-content;
  }

  .weeks {
    display: grid;
    grid-template-columns: repeat(var(--week-count), var(--cell-size));
    column-gap: var(--cell-gap);
  }

  .week {
    display: grid;
    grid-template-rows: repeat(7, var(--cell-size));
    row-gap: var(--cell-gap);
  }

  .day {
    width: var(--cell-size);
    height: var(--cell-size);
    display: block;
    border-radius: 2px;
    background: var(--level-none);
  }

  .day[data-level="first"] {
    background: var(--level-first);
  }

  .day[data-level="second"] {
    background: var(--level-second);
  }

  .day[data-level="third"] {
    background: var(--level-third);
  }

  .day[data-level="fourth"] {
    background: var(--level-fourth);
  }

  @media (prefers-color-scheme: light) {
    .contributions {
      --level-none: rgb(0 0 0 / 7%);
      --level-first: rgb(227 0 22 / 18%);
      --level-second: rgb(227 0 22 / 34%);
      --level-third: rgb(227 0 22 / 57%);
      --level-fourth: rgb(227 0 22 / 86%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contributions-link {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .contributions {
      --cell-size: 1.3vw;
      --cell-gap: 0.45vw;
    }
  }
</style>
