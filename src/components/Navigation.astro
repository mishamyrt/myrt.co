---
import Typography from "./Typography.astro";
import { defineTranslations } from "../utils/i18n/defineTranslations";
import { type Locale, localizedPath, globalPath } from "../utils/i18n";

interface Props {
  locale: Locale;
  showLocaleSwitcher?: boolean;
}

type NavigationTarget = {
  title: string;
  href: string;
};

const { locale, showLocaleSwitcher = true } = Astro.props;

const t = defineTranslations({
  ru: {
    experience: "Опыт",
    projects: "Проекты",
    blog: "Блог",
  },
  en: {
    experience: "Experience",
    projects: "Projects",
    blog: "Blog",
  },
})[locale];

const targets: NavigationTarget[] = [
  { title: t.experience, href: localizedPath(locale, "/") },
  { title: t.projects, href: localizedPath(locale, "/projects/") },
  { title: t.blog, href: localizedPath(locale, "/blog/") },
];

const pathname = globalPath(Astro.url.pathname);
const localeTargets: NavigationTarget[] = [
  { title: "РУ", href: localizedPath("ru", pathname) },
  { title: "EN", href: localizedPath("en", pathname) },
];

const state = targets.map((target) => ({
  ...target,
  active: Astro.url.pathname === target.href,
  sublink:
    target.href === localizedPath(locale, "/blog/") &&
    Astro.url.pathname.startsWith(target.href),
}));

const localeState = localeTargets.map((target) => ({
  ...target,
  active: Astro.url.pathname === target.href,
}));
---

<div class="navigation">
  <nav>
    {
      state.map(({ title, href, active, sublink }) => (
        <Typography
          class:list={{
            active,
            sublink,
          }}
          as="a"
          href={href}
          variant="heading-xs"
          color={active || sublink ? "primary" : "tertiary"}
        >
          {title}
        </Typography>
      ))
    }
  </nav>
  <div class="locale">
    {
      showLocaleSwitcher &&
        localeState.map(({ title, href, active }) => (
          <Typography
            class:list={{
              active,
            }}
            as="a"
            href={href}
            variant="heading-2xs"
            color={active ? "primary" : "tertiary"}
          >
            {title}
          </Typography>
        ))
    }
  </div>
</div>

<style lang="scss">
  .navigation {
    display: flex;
    justify-content: space-between;
    max-width: var(--size-layout-content-narrow);
  }

  .locale {
    display: flex;

    :global(a) {
      text-decoration: none;
    }

    :global(a:first-child::after) {
      content: "";
      display: inline-block;
      width: 1px;
      height: 8px;
      background-color: var(--color-content-tertiary);
      margin-left: 8px;
    }

    :global(a:last-child) {
      padding-left: 8px;
    }
  }

  nav {
    display: flex;
    gap: 18px;
  }

  a.active {
    cursor: default;
    text-decoration: none;
    pointer-events: none;
  }

  a.sublink {
    color: var(--color-text-primary);
  }

  a.language {
    margin-left: 6px;
  }
</style>
