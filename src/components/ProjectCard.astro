---
import type { CollectionEntry } from 'astro:content';
import Typography from './Typography.astro';
import { defineTranslations } from '../utils/i18n/defineTranslations';
import type { Locale } from '../utils/i18n/locales';
import { formatMonthYear } from '../utils/date';

interface Props {
  data: CollectionEntry<"projects">;
  locale: Locale;
}

const { data, locale } = Astro.props;
const project = data.data;
const hasAdditionalInfo = project.period || project.stack;
const isFinished = Boolean(project.period && project.period.end)

const t = defineTranslations({
  ru: {
    period: "Период",
    start: "Начало",
    stack: "Стек",
  },
  en: {
    period: "Period",
    start: "Started",
    stack: "Stack",
  },
})[locale];
---

<article class="project">
  <a class="project-image honey" data-hold="400" data-effect="slide" data-right="32px" href={project.link}>
    <img class:list={{
      rounded: project.rounded
    }} src={`/projects/${project.img}`} alt={project.name} />
  </a>
  <div class="project-description honey" data-hold="200" data-up="32px">
    <Typography class="project-title" variant="heading-m" color="primary" as="h2">
      <a href={project.link}>{project.name}</a>
    </Typography>
    <Typography color="secondary">
      {project.description[locale]}
    </Typography>
    {hasAdditionalInfo && (
      <dl>
        {project.period && (
          isFinished ? (
            <dt>{t.period}</dt>
            <dd>
              {formatMonthYear(project.period.start, locale)}{" — "}{formatMonthYear(
                project.period.end!,
                locale,
              )}
            </dd>
          ) : (
            <dt>{t.start}</dt>
            <dd>{formatMonthYear(project.period.start, locale)}</dd>
          )
        )}
        {project.stack && (
          <dt>{t.stack}</dt>
          <dd>{project.stack}</dd>
        )}
      </dl>
    )}
  </div>
</article>

<style lang="scss">
.project {
  max-width: 1000px;
  display: flex;
  flex-direction: row-reverse;
  gap: 36px;

  &-image {
    width: 100%;
    max-width: 560px;
  }

  &-description {
    position: relative;
    top: -5px;
  }

  img {
    max-width: 560px;

    &.rounded {
      border-radius: 10px;
    }
  }

  & + & {
    margin-top: 51px;
  }
}

dl {
  display: grid;
  grid-template-columns: 80px 1fr;
  font: var(--typography-text-s);
  letter-spacing: var(--typography-text-s_spacing);
  color: var(--color-content-secondary);
  margin: 26px 0 0;
}

dd {
  margin: 0;
}

@media (prefers-color-scheme: light) {
  .project img {
    filter: drop-shadow(0px 8px 24px rgb(0 0 0 / 10%));
  }
}

@media (max-width: 1050px) {
  .project {
    flex-direction: column;
    gap: 24px;

    img {
      width: 100%;
    }
  }

  p {
    max-width: 575px;
  }
}

@supports (corner-shape:superellipse(1.6)) {
  .project img.rounded {
    border-radius: 16px;
    corner-shape: superellipse(1.6);
  }
}
</style>
