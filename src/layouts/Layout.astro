---
import { Font } from "astro:assets";

import Navigation from "../components/Navigation.astro";
import DebugGrid from "../components/DebugGrid.astro";
import "../styles/main.scss";

const siteUrl = "https://myrt.co";
const pageUrl = `${siteUrl}${Astro.url.pathname}`
const defaultImage = "/userpic-large@2x.jpg";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpg" href="/avatar@2x.jpg" />
    <link rel="canonical" href={pageUrl} />
    <Font cssVariable="--typography-font-family-sans-serif" />
    <Font cssVariable="--typography-font-family-serif" />
    <Font cssVariable="--typography-font-family-monospace" />
    {description && (
      <meta name="description" content={description} />
      <meta name="og:description" content={description} />
    )}
    <meta property="og:image" content={image ?? defaultImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <div class="content">
      <Navigation />
      <DebugGrid step={9} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  import "honeymate";
  import { attachHover } from '../scripts/doubleHover'

  attachHover('hover');
</script>

<style is:global>
  body,
  html {
    background-color: var(--color-background-primary);

    --layout-padding-min: 117px;
  }

  body {
    padding: 31px 18px;
  }

  .content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 0 0 max(7%, var(--layout-padding-min));
  }

  main {
    padding: 39px 0;
  }

  @media (max-width: 873px) {
    .content {
      padding: 0;
    }
  }

  @media (max-width: 610px) {
    body {
      padding: 22px 18px;
    }
  }
</style>
