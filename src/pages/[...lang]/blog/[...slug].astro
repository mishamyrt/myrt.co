---
import { getCollection, render } from "astro:content";

import Layout from "$layouts/Layout.astro";
import Typography from "$components/Typography.astro";
import { formatFullDate, parseFullDate } from "$utils/date";
import {
  defineTranslations,
  contentLocale,
  globalSlug,
  defaultLocale,
} from "$utils/i18n";

export async function getStaticPaths() {
  const articles = await getCollection("blog");
  return articles.map((article) => {
    const locale = contentLocale(article.id);
    return {
      params: {
        lang: locale === defaultLocale ? "" : locale,
        slug: globalSlug(article.id),
      },
      props: {
        article,
        locale: contentLocale(article.id),
      },
    };
  });
}

const { article, locale } = Astro.props;
if (!locale) {
  throw new Error(`locale for article ${article.id}`);
}

const publishedDate = article.data.publishedAt
  ? parseFullDate(article.data.publishedAt)
  : null;
const date = publishedDate ? formatFullDate(publishedDate, locale) : null;
const { title, description } = article.data;
const { Content } = await render(article);

const t = defineTranslations({
  ru: {
    published: "Опубликовано",
  },
  en: {
    published: "Published",
  },
})[locale];
---

<Layout
  title={title}
  description={description}
  locale={locale}
  showLocaleSwitcher={false}
>
  <article>
    <h1>{title}</h1>
    <Content />
    {
      date && publishedDate && (
        <time datetime={publishedDate.toISOString().slice(0, 10)}>
          <Typography class="date" color="tertiary" variant="text-m">
            {t.published}
            <span> </span>
            {date}
          </Typography>
        </time>
      )
    }
  </article>
</Layout>

<style lang="scss">
  .date {
    margin-top: var(--space-m);
  }

  article {
    font-family: var(--typography-font-family-serif);

    .img-container {
      margin: calc(var(--space-l) + 1px) 0 var(--space-l);
    }

    .img-caption {
      font-family: var(--typography-text-s);
      letter-spacing: var(--typography-text-s_spacing);
      color: var(--color-content-tertiary);
      max-width: var(--size-layout-content-narrow);
      display: block;
      margin-top: 2px;
    }

    :global(.img-wrapper) {
      position: relative;
      max-width: 100%;

      :global(img) {
        position: absolute;
        width: 100%;
        height: 100%;
      }
    }

    :global(p) {
      color: var(--color-content-secondary);
      font: var(--typography-text-m);
      letter-spacing: var(--typography-text-m_spacing);
      max-width: var(--size-layout-content-narrow);
      margin: var(--space-m) 0 0;
    }

    :global(a) {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.175em;
      text-decoration-color: var(--color-link-underline);

      &:hover,
      &.hover {
        color: var(--color-link_hover);
        text-decoration-color: var(--color-link-underline_hover);
      }
    }

    :global(h1) {
      font: var(--typography-heading-l);
      letter-spacing: var(--typography-heading-l_spacing);
      margin: -1px 0 calc(var(--space-m) + 1px) -1px;
      color: var(--color-content-primary);
      max-width: var(--size-layout-content-narrow);
    }

    :global(h2) {
      font: var(--typography-heading-m);
      letter-spacing: var(--typography-heading-m_spacing);
      margin: calc(var(--space-xl) - 3px) 0 calc(var(--space-s) + 3px);
      max-width: var(--size-layout-content-narrow);
      color: var(--color-content-primary);
    }

    :global(h3) {
      font: var(--typography-heading-s);
      color: var(--color-content-primary);
      margin: calc(var(--space-xl) - 4px) 0 calc(var(--space-s) + 3px);
    }

    :global(h3 + p) {
      margin-top: calc(var(--space-m) - 5px);
    }

    :global(h2 + p) {
      margin-top: calc(var(--space-m) - 6px);
    }

    :global(pre + h2) {
      margin-top: calc(var(--space-xl) - 1px);
    }

    :global(ul),
    :global(ol) {
      margin: 0;
      max-width: calc(var(--size-layout-content-narrow) - var(--space-l));
      padding-left: var(--space-l);
    }

    :global(ul) {
      list-style-type: none;
    }

    :global(li) {
      color: var(--color-content-secondary);
      font: var(--typography-text-m);
      margin-top: var(--space-s);
    }

    :global(blockquote) {
      padding-left: var(--space-xl);
      max-width: var(--size-layout-content-narrow);
      margin: var(--space-m) 0;
    }

    :global(a) {
      color: var(--color-content-link);
    }

    :global(a:hover),
    :global(a.hover) {
      text-decoration: underline;
    }

    :global(a code) {
      color: var(--color-content-link);
    }

    :global(code) {
      font: var(--typography-code-m);
      color: var(--color-content-primary);
      background-color: var(--color-background-secondary);
    }

    :global(p code),
    :global(ul code),
    :global(ol code) {
      position: relative;
      color: var(--color-content-secondary);
      background-color: var(--color-background-secondary);
      padding: 0 2px;
      margin: 0;
      border-radius: 3px;
      line-height: 1;
    }

    :global(pre) {
      font: var(--typography-code-m);
      width: calc(var(--size-layout-content-narrow) + 40px);
      margin: calc(var(--space-m) + 4px) 0px calc(var(--space-m) + 2px) -20px;
      padding: 15px 20px;
      border-radius: 8px;
      background-color: var(--color-background-secondary) !important;
    }

    :global(table) {
      font: var(--typography-text-m);
      color: var(--color-content-secondary);
      margin: var(--space-m) 0 0;
      border-collapse: collapse;
      max-width: var(--size-layout-content-narrow);
    }

    :global(table + h2) {
      margin-top: calc(var(--space-xl) - 12px);
    }

    :global(table .line) {
      height: 27px;
      display: inline-block;
    }

    :global(th) {
      font: var(--typography-heading-s);
      color: var(--color-content-primary);
      text-align: left;
      padding: 0;
      line-height: 27px;
    }

    :global(tr) {
      line-height: 27px;
      vertical-align: top;
    }

    :global(th),
    :global(td) {
      padding: 0 var(--space-m) var(--space-s) 0;
    }

    :global(td code) {
      background: none;
      font: var(--typography-code-s);
      color: var(--color-content-secondary);
    }
  }

  @media (max-width: 873px) {
    :global(pre) {
      margin-left: 0;
      max-width: var(--size-layout-content-narrow);
      width: 100%;
    }

    :global(table) {
      table-layout: fixed;
    }

    :global(td),
    :global(th) {
      vertical-align: top;
    }
  }
</style>
