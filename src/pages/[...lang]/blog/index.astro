---
import Layout from "$layouts/Layout.astro";
import Typography from "$components/Typography.astro";
import InfinitySign from "$components/InfinitySign.astro";
import { parseFullDate } from "$utils/date";
import {
  defineTranslations,
  getCollectionByLocale,
  localizedStaticPaths,
  globalSlug,
} from "$utils/i18n";

export function getStaticPaths() {
  return localizedStaticPaths();
}

const CONTINUOUS = "∞";

const { locale } = Astro.props;

const t = defineTranslations({
  ru: {
    title: "Блог Михаила Хрустика",
    description: "Блог о дизайне, технологиях и жизни.",
    intro:
      "Пишу о дизайне, технологиях, кофе и всём, что меня волнует. Пытаюсь научиться писать регулярно.",
    empty: "Пока здесь нет опубликованных статей.",
  },
  en: {
    title: "Mikhael Khrustik’s blog",
    description: "A blog about design, technology, and life.",
    intro:
      "I write about design, technology, coffee, and whatever else is on my mind. I am trying to make it a regular habit.",
    empty: "There are no published articles here yet.",
  },
})[locale];

const localePrefix = locale === "ru" ? "" : `/${locale}`;
const articles = (await getCollectionByLocale("blog", locale)).map(
  (article) => ({
    ...article,
    data: {
      ...article.data,
      href: `${localePrefix}/blog/${globalSlug(article.id)}/`,
    },
  }),
);

const articlesMap = articles.reduce(
  (acc, article) => {
    if (!article.data.publishedAt) {
      return acc;
    }
    if (article.data.continuous) {
      if (!acc[CONTINUOUS]) {
        acc[CONTINUOUS] = [];
      }
      acc[CONTINUOUS].push(article);
      return acc;
    }
    const year = parseFullDate(article.data.publishedAt).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(article);
    return acc;
  },
  {} as Record<string, typeof articles>,
);

const articlesByYear = Object.entries(articlesMap).sort((a, b) => {
  if (a[0] === CONTINUOUS) {
    return -1;
  }
  if (b[0] === CONTINUOUS) {
    return 1;
  }
  return parseInt(b[0], 10) - parseInt(a[0], 10);
});
---

<Layout title={t.title} description={t.description} locale={locale}>
  <Typography color="secondary" class="heading honey" data-effect="slide">
    {t.intro}
  </Typography>
  <div class="blog honey" data-effect="slide" data-hold="200" data-down="50px">
    {articlesByYear.length === 0 ? (
      <Typography color="tertiary">{t.empty}</Typography>
    ) : (
      articlesByYear.map(([year, yearArticles]) => (
        <div class="blog-yearArticles">
          {year === CONTINUOUS ? (
            <div class="blog-year __continuous">
              <InfinitySign />
            </div>
          ) : (
            <span class="blog-year">{year}</span>
          )}
          <div class="blog-articles">
            {yearArticles.map((article) => (
              <a class="blog-article" href={article.data.href}>
                <Typography
                  class="blog-title"
                  variant="heading-m"
                  color="primary"
                  as="h3"
                >
                  {article.data.title}
                </Typography>
                <Typography variant="text-m" color="secondary">
                  {article.data.description}
                </Typography>
              </a>
            ))}
          </div>
        </div>
      ))
    )}
  </div>
</Layout>

<style lang="scss">
  @use "../../../styles/typography.scss";

  .heading {
    max-width: var(--layout-content-narrow);
  }

  .blog {
    margin-top: calc(var(--layout-grid-base) * 6);
  }

  .typography.blog-title {
    margin-bottom: 0.2em;
  }

  .blog-yearArticles {
    max-width: var(--layout-content-narrow);
    display: flex;
    position: relative;
    margin-top: var(--space-xl);
  }

  .blog-article + .blog-article {
    margin-top: var(--space-l);
  }

  .blog-articles {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .blog-year {
    @include typography.heading-m;
    color: var(--color-content-tertiary);
    text-align: right;
    width: 3em;
    position: absolute;
    left: calc((3em + (var(--layout-grid-base) * 4)) * -1);
    top: -0.37em;

    &.__continuous {
      fill: var(--color-content-tertiary);
      display: flex;
      align-items: start;
      justify-content: end;
      top: -0.1em;

      svg {
        width: 29px;
        height: 14px;
      }
    }
  }

  .blog-article {
    text-decoration: none;

    .blog-title {
      transition-duration: 0.2s;
      transition-timing-function: ease-out;
      transition-property: color;
    }

    &:hover .blog-title {
      transition-duration: 0s;
      color: var(--color-link_hover);
    }
  }

  @media screen and (max-width: 873px) {
    .blog-year,
    .blog-year.__continuous {
      @include typography.heading-s;
      transform: rotate(-90deg) translateX(-100%);
      transform-origin: 0;
      position: absolute;
      top: calc(var(--space-m) * -1);
      left: calc(var(--space-layout-aside) * -1 - 0.25em);

      svg {
        transform: scale(0.7);
      }
    }
  }

  @media screen and (max-width: 480px) {
    .blog-year,
    .blog-year.__continuous {
      @include typography.heading-xs;
      transform: unset;
      left: unset;
      top: -48px;
      justify-content: start;
      text-align: left;
    }

    .blog-yearArticles {
      flex-direction: column;
      margin-top: calc(var(--layout-grid-base) * 9);
    }
  }
</style>
