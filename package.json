{
  "name": "myrt.co",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm dev",
    "build": "pnpm check:content && astro build",
    "dev": "astro dev",
    "check:content": "node scripts/check-content.mjs",
    "content:ack": "node scripts/check-content.mjs --update",
    "typograf": "node scripts/typograf.mjs",
    "build:docker": "docker build -t myrt-co:latest .",
    "prebuild:docker": "pnpm build",
    "start:docker": "docker run --name myrt-app -d -p 80:80 -p 443:443 myrt-co:latest",
    "stop:docker": "docker stop myrt-app || true && docker rm -f myrt-app || true",
    "lint:styles": "stylelint 'src/styles/*'",
    "spell-check": "cspell --show-suggestions --relative 'src/**/*.astro' 'src/**/*.md'",
    "lint": "pnpm lint:styles"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.0",
    "astro": "7.2.10",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "postcss-scss": "4.0.9",
    "sass": "1.103.1",
    "satteri": "0.10.5",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "typograf": "7.8.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@ibm/plex-serif": "2.0.0",
    "@types/node": "26.4.0",
    "astro-compressor": "1.3.0",
    "honeymate": "5.2.2",
    "image-size": "2.0.2",
    "inter-ui": "4.1.1",
    "lilex-font": "2.7.0",
    "yaml": "2.9.0"
  }
}
